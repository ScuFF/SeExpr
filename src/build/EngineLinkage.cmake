# Application-level engine choice. Keep the compiler in one shared engine when
# selected, while permitting standalone static applications in the same build.
if(WIN32)
    set(default_engine_linkage STATIC)
    set(seexpr_static_engine SeExpr2)
    set(seexpr_shared_engine SeExpr2Shared)
    set(seexpr_static_editor SeExpr2Editor)
    set(seexpr_shared_editor SeExpr2EditorShared)
else()
    set(default_engine_linkage SHARED)
    set(seexpr_static_engine SeExpr2Static)
    set(seexpr_shared_engine SeExpr2)
    set(seexpr_static_editor SeExpr2EditorStatic)
    set(seexpr_shared_editor SeExpr2Editor)
endif()
set(SEEXPR_DEFAULT_LINKAGE "${default_engine_linkage}" CACHE STRING "Default application engine linkage")
set_property(CACHE SEEXPR_DEFAULT_LINKAGE PROPERTY STRINGS STATIC SHARED)
if(NOT SEEXPR_DEFAULT_LINKAGE MATCHES "^(STATIC|SHARED)$")
    message(FATAL_ERROR "SEEXPR_DEFAULT_LINKAGE must be STATIC or SHARED")
endif()

# Empty leaves standard CMake output-directory behavior intact.
set(SEEXPR_RUNTIME_OUTPUT_DIRECTORY "" CACHE PATH "Optional common directory for SeExpr runtime binaries")
function(seexpr_set_runtime_output target)
    if(SEEXPR_RUNTIME_OUTPUT_DIRECTORY)
        set_target_properties(${target} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY "${SEEXPR_RUNTIME_OUTPUT_DIRECTORY}"
            LIBRARY_OUTPUT_DIRECTORY "${SEEXPR_RUNTIME_OUTPUT_DIRECTORY}")
    endif()
endfunction()

function(seexpr_link_engine target)
    set(setting "SEEXPR_LINKAGE_${target}")
    set(${setting} DEFAULT CACHE STRING "Engine linkage for ${target}")
    set_property(CACHE ${setting} PROPERTY STRINGS DEFAULT STATIC SHARED)
    set(linkage "${${setting}}")
    if(linkage STREQUAL DEFAULT)
        set(linkage "${SEEXPR_DEFAULT_LINKAGE}")
    endif()
    if(linkage STREQUAL SHARED)
        set(engine ${seexpr_shared_engine})
        set(editor ${seexpr_shared_editor})
    elseif(linkage STREQUAL STATIC)
        set(engine ${seexpr_static_engine})
        set(editor ${seexpr_static_editor})
    else()
        message(FATAL_ERROR "${setting} must be DEFAULT, STATIC or SHARED")
    endif()
    target_link_libraries(${target} ${engine})
    if("EDITOR" IN_LIST ARGN)
        target_link_libraries(${target} ${editor})
    endif()
    seexpr_set_runtime_output(${target})
    set_property(TARGET ${target} PROPERTY SEEXPR_ENGINE_LINKAGE "${linkage}")
    message(STATUS "${target}: ${linkage} SeExpr engine")
endfunction()
